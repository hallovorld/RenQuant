<?xml version="1.0" encoding="UTF-8"?>
<!-- P0.5 dead-man switch: every 5 min, trips TRADING_OFF when the stream
     watchdog heartbeat goes stale during RTH. OPERATOR DEPLOY STEP:
     cp to ~/Library/LaunchAgents/com.renquant.deadman.plist && launchctl load -w.
     Deploy ONLY after the watchdog (P0.1) has its 5 clean sessions. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.renquant.deadman</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin/python</string>
        <string>/Users/renhao/git/github/RenQuant/scripts/deadman_check.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/renhao/git/github/RenQuant</string>
    <key>StartInterval</key><integer>300</integer>
    <key>StandardOutPath</key><string>/Users/renhao/renquant-data/watchdog/deadman_stdout.log</string>
    <key>StandardErrorPath</key><string>/Users/renhao/renquant-data/watchdog/deadman_stderr.log</string>
</dict>
</plist>
