<?xml version="1.0" encoding="UTF-8"?>
<!-- P0.1 stream watchdog (read-only). OPERATOR DEPLOY STEP:
     cp to ~/Library/LaunchAgents/com.renquant.stream-watchdog.plist
     then: launchctl load -w ~/Library/LaunchAgents/com.renquant.stream-watchdog.plist
     KeepAlive restarts it on crash; the daemon itself reconnects the stream.
     Acceptance gate per roadmap §4 P0.1: 5 sessions of clean event logs
     (~/renquant-data/watchdog/events_*.jsonl) before anything consumes it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.renquant.stream-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin/python</string>
        <string>/Users/renhao/git/github/RenQuant/live/stream_watchdog.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/renhao/git/github/RenQuant</string>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/renhao/renquant-data/watchdog/stdout.log</string>
    <key>StandardErrorPath</key><string>/Users/renhao/renquant-data/watchdog/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
