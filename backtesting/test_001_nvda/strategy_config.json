  "backtest_end": "2026-03-01",
  "indicator_spec": {
    "rsi": {"period": 14},
    "macd": {"fast": 12, "slow": 26, "signal": 9},
    "cci": {"period": 20},
    "bbp": {"period": 20},
    "adx": {"period": 14},
    "williams_r": {"period": 14},
    "obv": {"signal_period": 20}
  },
  "model_params": {
    "feature_columns": ["rsi", "macd_hist", "cci", "bbp", "adx", "williams_r", "obv_slope"],
    "lookahead": 10,
