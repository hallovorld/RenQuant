.claude/scheduled_tasks.lock
.claude/worktrees/

# Env
.env
.venv/

# macOS
.DS_Store

# Local DBs and backup snapshots. Evidence artifacts should be summarized in
# docs, not accidentally staged as raw runtime stores.
*.db
*.db-journal
*.bak
*.bak_*
*.disabled-*

# Local data cache — huge training panels stay ignored, but data/exp/ is a
# deliberate, small, committed experiment-evidence path (2026-07-02, Track A
# regen_oos_pick_table.py) that must NOT be swept up by the blanket rule.
# CORRECTION (Codex review on #430): a committed .parquet under data/exp/
# still matches renquant-orchestrator's agent_workflows.PROD_PATH_RULES
# protected-path regex (`(^|/)data/.*\.parquet$`) and is mechanically
# rejected at merge review — parquet payloads under data/exp/ stay
# git-ignored; only the durable regeneration manifest (.manifest.json) and
# other small non-parquet evidence commit.
/data/*
!/data/exp/
/data/exp/*.parquet

# Live trading and daily run logs
live/logs/
logs/

# LEAN runtime
backtesting/lean.json
backtesting/data/
backtesting/*/backtests/

# Live trading state (personal) — job-written every run.
# NOTE: the broker-suffixed names (live_state.alpaca.json,
# live_state.alpaca_shadow.json, …) were NOT matched by the bare
# live_state.json pattern, so they stayed git-tracked and made the live
# tree perpetually dirty (a git checkout/reset could clobber live trading
# state — the root cause of a prior multi-day outage). Match every broker
# variant so these never re-enter the index.
backtesting/*/live_state.json
backtesting/*/live_state.*.json

# Job-written runtime outputs (regenerated every run; classified as
# runtime-dirty by scripts/check_ops_deployment_ready.py).
doc/dashboard.md

# Throwaway pin-rollback snapshots written by scripts/promote_pin.py
# (.promote-bak.<timestamp>); only read back by an explicit `revert`, never
# meant to be versioned.
subrepos.lock.json.promote-bak.*

# Temporary backup directory produced by scripts/compare_panel_backends.py
# while swapping backends in-memory during an A/B. Not meant to be versioned.
backtesting/*/artifacts/.compare_backup/
backtesting/*/artifacts/.tests_backup/
backtesting/*/artifacts/.lightgbm_ab_backup/

# Transformer panel artifacts — backend is shelved per
# doc/panel_training_runs.md::A/B — 2026-04-23 (ratio 0.49 vs XGBoost).
# Kept locally for future A/Bs but not versioned. To ship the transformer
# backend, delete these lines and commit the artifact alongside a config
# change flipping panel_ltr.backend = "transformer".
backtesting/*/artifacts/panel-transformer.pt
backtesting/*/artifacts/panel-transformer.json

# Local archive (notebook snapshots, etc — not tracked)
archive/
knowledge/chromadb/

# Strategy config backups + preview snapshots (P5 deploy artefact)
backtesting/renquant_104/strategy_config.json.pre-*
backtesting/renquant_104/strategy_config.json.preview_backup_*


# DOE: per-trial dirs are large (val_preds parquets) — only commit aggregates
artifacts/patchtst_doe_hf/pt_*/
artifacts/patchtst_doe_hf_smoke/
artifacts/hf_smoke/
artifacts/hf_swa_smoke/
