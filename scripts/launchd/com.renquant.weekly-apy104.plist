<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly APY health monitor, Sunday 12:00 PT.
  The Python wrapper defaults to renquant_orchestrator.weekly_apy_monitor
  and falls back to the umbrella implementation only when the subrepo module
  is not installed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.weekly-apy104</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin/python</string>
        <string>/Users/renhao/git/github/RenQuant/scripts/weekly_apy_check.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/live_104/weekly_apy_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/live_104/weekly_apy_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/renhao/git/github/RenQuant</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
