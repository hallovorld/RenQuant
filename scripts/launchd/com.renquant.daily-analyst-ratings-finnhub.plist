<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily Finnhub analyst-ratings refresh — every day 04:25 PT.

  Finnhub free `/stock/recommendation` pull: the WHOLE watchlist each
  day (--max-pull 0), throttled ~1s (free tier 60 calls/min, ~145
  names ≈ 2.5 min). Broad US-stock coverage (live probe 136/145 with
  data; the rest returned no_coverage). The free window is only ~4
  months, so daily accumulation (dedup by (ticker, period)) grows the
  multi-month series the 3-month revision signal needs.

  Fails closed: --fail-on-error exits non-zero on ANY quota/fetch
  error (no per-429 tolerance); --min-coverage-pct is a secondary
  floor on the COVERABLE set (excludes the ambiguous no_coverage).
  The ntfy reports active_coverage_pct + no_coverage_pct alongside the
  coverable cov, so a high coverable % is never read as full active
  coverage and the gap stays visible. no_coverage is NOT assumed to be
  ETFs (an empty response is ambiguous).

  INERT until base-data #25 merges + the base-data pin is bumped —
  until then the wrapper reports "module unavailable" and exits
  non-zero. Do NOT load from this PR; install only AFTER the pin bump:
    cp scripts/launchd/com.renquant.daily-analyst-ratings-finnhub.plist \
       ~/Library/LaunchAgents/
    launchctl load \
       ~/Library/LaunchAgents/com.renquant.daily-analyst-ratings-finnhub.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.daily-analyst-ratings-finnhub</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/daily_analyst_ratings_finnhub_refresh.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Daily 04:25 PT — offline hours, 25 min after the weekly
             fundamental-refresh slot so they never overlap. -->
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>25</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/daily_analyst_ratings_finnhub/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/daily_analyst_ratings_finnhub/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
