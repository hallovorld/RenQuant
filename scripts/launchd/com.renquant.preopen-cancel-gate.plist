<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pre-open cancel gate — every market-day morning 15 min before open.

  ET market opens 09:30. Pacific equivalent 06:30 PT during EDT (Mar-Nov)
  / 06:30 PT during EST is actually 06:30 PT = 09:30 ET → fires at 06:15
  PT both seasons. (macOS launchd uses local time; we live in Pacific.
  DST drift handled by the underlying timezone since launchd respects
  the current TZ.)

  Why: weekend / overnight macro events (Fed surprise, geopolitical
  shock) can produce 3-5%+ gap-down opens. Daily-cron post-close
  market-on-open orders fill at the catastrophic gap price. This gate
  measures overnight ES=F move + σ-normalized severity; cancels all
  pending market orders when |severity| ≥ 2σ (Shewhart 2σ rule).

  Scientific basis:
    French-Roll 1986 (overnight info accumulation)
    Bollerslev-Andersen-Diebold 2008 (overnight σ ≈ 1.4 × intraday σ)
    Shewhart 1931 (2σ statistical control limit)

  Install:
    cp scripts/launchd/com.renquant.preopen-cancel-gate.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.renquant.preopen-cancel-gate.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.preopen-cancel-gate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/preopen_cancel_gate.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/renhao/git/github/RenQuant</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/preopen_gate/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/preopen_gate/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
