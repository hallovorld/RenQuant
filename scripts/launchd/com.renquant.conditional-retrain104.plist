<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Conditional retrain on SPY/VIX anomalies — 13:10 PT Mon-Fri.
  Runs 45 minutes BEFORE daily_104.sh (13:55 PT). If an anomaly fires,
  conditional_retrain_104.sh delegates to weekly_wf_promote.sh so any new
  model still passes the walk-forward trust boundary before promotion.

  Triggers:
    SPY daily move greater than 2% -> weekly_wf_promote.sh trigger=anomaly_spy_2pct
    VIX daily move greater than 5% -> weekly_wf_promote.sh trigger=anomaly_vix_5pct

  Install:
    cp scripts/launchd/com.renquant.conditional-retrain104.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.renquant.conditional-retrain104.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.conditional-retrain104</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/conditional_retrain_104.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Mon (1) / Tue (2) / Wed (3) / Thu (4) / Fri (5) at 13:10 PT.
             Apple launchd: Mon=1..Fri=5, Sat=6, Sun=0/7. Was 2..6
             (Tue..Sat) — silent skip of Mondays + Saturday-with-stale-data
             fires until 2026-05-20 audit caught it. -->
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>10</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/conditional_retrain_104/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/conditional_retrain_104/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
