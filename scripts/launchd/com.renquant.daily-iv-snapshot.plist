<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily IV snapshot — weekdays 13:30 PT (16:30 ET, 30 min post-close).

  Roadmap C1 (2026-05-18). Alpaca Free Options API gives current
  snapshots only (no historical chains). This cron accumulates EOD
  snapshots so we can eventually backfill panel features for the
  iv_skew_30d / iv_term_struct / iv_30d_*_atm signals (Bali-Hovakimian
  2009, Cremers-Weinbaum 2010).

  Estimated time to "enough panel": ~6 months. After that, integration
  is possible. Per §5.13.6: one snapshot per trading day adds one
  panel row per ticker — that's the maximum information for daily-
  resolution features.

  Install:
    cp scripts/launchd/com.renquant.daily-iv-snapshot.plist \
       ~/Library/LaunchAgents/
    launchctl load \
       ~/Library/LaunchAgents/com.renquant.daily-iv-snapshot.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.daily-iv-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/daily_iv_snapshot.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Mon-Fri at 13:30 PT (16:30 ET, 30min post-close). -->
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/iv_snapshot/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/iv_snapshot/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
