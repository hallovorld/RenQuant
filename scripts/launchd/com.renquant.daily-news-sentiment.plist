<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily news + sentiment refresh — weekdays 06:30 PT (07:00 ET).

  Roadmap C5 step 3 (2026-05-18). Fetches yesterday's Alpaca News
  per watchlist ticker + re-scores with FinBERT (MPS). The
  per-ticker parquets get appended idempotently (drop_duplicates
  on symbol/created_at/headline).

  Cadence rationale (§5.13.6):
    - News flow updates daily; FinBERT sentiment is the daily aggregate
    - Earlier cadence (hourly) burns API calls without changing daily
      aggregate; later cadence (weekly) lags 1-2 days for inference
    - 06:30 PT runs BEFORE daily_104 (07:30 PT) so live model has
      fresh sentiment for today's decisions

  Install:
    cp scripts/launchd/com.renquant.daily-news-sentiment.plist \
       ~/Library/LaunchAgents/
    launchctl load \
       ~/Library/LaunchAgents/com.renquant.daily-news-sentiment.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.daily-news-sentiment</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/daily_news_sentiment_refresh.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/news_daily/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/news_daily/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
