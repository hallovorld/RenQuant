<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly walk-forward retrain + WF gate + promote (Sat 04:00 PT).

  2026-05-09 audit FIX-C: REPLACES the daily auto-promote (which used
  RQ_ALLOW_NO_WF=1 bypass). Saturday morning weekend buffer ensures
  market is closed throughout the entire 90-min run.

  Steps (delegate to scripts/weekly_wf_promote.sh):
    1. smoke test
    2. retrain panel-LTR (alpha158 + 5 fund + 3 PEAD + 3 SUE)
    3. run_wf_gate.py --strict (3-cut WF + §5.2 sanity battery)
    4. promote() — refused if wf_gate_metadata.passed != True
    5. ntfy alert with verdict

  Install:
    cp scripts/launchd/com.renquant.weekly-wf-promote.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.renquant.weekly-wf-promote.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.weekly-wf-promote</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/weekly_wf_promote.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Saturday (7 in launchd's Sun=1..Sat=7 OR macOS uses Sun=0..Sat=6;
             use Weekday=7 which is Sat in modern macOS launchd convention.
             04:00 PT = ~07:00 ET = market closed all weekend. -->
        <key>Weekday</key><integer>7</integer>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/weekly_wf_promote/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/weekly_wf_promote/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/miniconda3/envs/renquant/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
