<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly per-ticker TOURNAMENT retrain (Sunday 06:00 PT).

  Restores the MISSING cadence for the per-ticker tournament (RL Q-table +
  RandomForest + per-ticker XGB, in backtesting/renquant_104/models/<TICKER>/)
  that gates UNIVERSE ADMISSION. It had no scheduled job, silently aged to 61d,
  and had to be hand-retrained on 2026-06-30 (a recurring driver of the
  no-buys). Delegates to scripts/weekly_tournament_retrain.sh, which:
    1. acquires a stale-PID-aware lock
    2. runs `scripts/train_104.py --skip-panel --force` under the pinned venv
       + subrepo PYTHONPATH (BaselineTournamentJob only; panel/calibrator are
       owned by weekly_wf_promote.sh)
    3. stamps a "last successful tournament retrain" marker for the freshness
       monitor (orchestrator PR #213)
    4. FAILS LOUDLY via ntfy on any non-zero exit — a silent failure is what
       aged the tournament out in the first place.

  Sunday 06:00 PT (Weekday=0): avoids CPU contention with the two Saturday
  04:00 core-saturating jobs (weekly-wf-promote + weekly-fundamental-refresh)
  and lands before Sunday's lighter jobs (retrain-panel104 10:00 no-op,
  weekly-apy104 12:00, screen-watchlist 12:05). Market closed all weekend.
  (launchd Weekday: 0 and 7 BOTH = Sunday, Saturday = 6 — same convention as
  the sibling retrain-panel104 / weekly-wf-promote plists.)

  Install (OPERATIONAL — not done by this PR):
    cp scripts/launchd/com.renquant.weekly-tournament-retrain.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.renquant.weekly-tournament-retrain.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.weekly-tournament-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/weekly_tournament_retrain.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Sunday 06:00 PT. Weekday=0 = Sunday (Apple launchd.plist(5):
             0 and 7 both = Sunday, Saturday = 6). -->
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/weekly_tournament_retrain/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/weekly_tournament_retrain/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/renhao/git/github/RenQuant</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
