<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Monthly meta-label retrain — 1st of every month, 03:30 PT.

  2026-05-11 P-RETRAIN: the meta-label exit classifier
  (López de Prado AFML ch.20) ages out when the panel-LTR score
  distribution + path-rule trigger patterns drift. Monthly refit
  keeps the artifact aligned with current market structure.

  Why 03:30 (NOT 03:00): runs AFTER the monthly calibrator
  refresh (03:00 PT). Calibrator drift correction is upstream of
  meta-label snapshot features (panel_score_current). Running
  meta-label retrain first would label snapshots against an
  outdated calibrator and the next-month live system against
  the new one — distribution mismatch.

  Steps (delegate to scripts/monthly_meta_label_retrain.sh):
    1. Range-find training window: today − 60d − 12mo
    2. Snapshot-collection sim (--meta_label_training.enabled)
    3. Triple-barrier labels (pt/sl=10, fwd=20)
    4. XGBoost + PurgedKFold-5 + 2% embargo
    5. Health gate (AUC ≥ 0.52, n_events ≥ 100, balance ∈ [0.3, 0.7])
    6. Atomic swap (backup → meta-label-exit.json)
    7. ntfy summary

  Install:
    cp scripts/launchd/com.renquant.monthly-meta-label-retrain.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.renquant.monthly-meta-label-retrain.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.monthly-meta-label-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/renhao/git/github/RenQuant/scripts/monthly_meta_label_retrain.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- 1st of every month at 03:30 PT (after monthly calibrator). -->
        <key>Day</key><integer>1</integer>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/monthly_meta_label/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/monthly_meta_label/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
