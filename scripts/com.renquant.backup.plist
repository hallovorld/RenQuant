<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.renquant.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/renhao/git/github/RenQuant/scripts/backup_to_github.sh</string>
    </array>

    <!--
      Every 4 hours during waking hours. Critical state writes happen on:
        * Sunday 10:00 — full retrain (~30 min CPU)
        * M-F 13:55   — daily refresh (~10 min CPU)
        * M-F 07:00-12:24 / every 12 min — intraday plist (live state writes)
        * Stage 3 / experimental retrains — ad-hoc, day or night
      4 h interval ensures live_state changes never lose more than 4 h of context.

      Skip 02:00-06:00 PT (no market activity, save CPU).
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/backup/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/renhao/git/github/RenQuant/logs/backup/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/renhao/git/github/RenQuant</string>

    <!--
      BACKUP_REMOTE must be set during one-time setup (see
      scripts/backup_to_github.sh header). After first clone the path is
      cached in $BACKUP_REPO/.git/config so this env var isn't strictly
      needed at run time, but kept here for clarity and re-clone scenarios.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/renhao/git/github/RenQuant/.venv/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>BACKUP_REPO</key>
        <string>/Users/renhao/.renquant-state-backup</string>
    </dict>
</dict>
</plist>
